{
  "name": "autoque",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts --dev",
    "build": "npm run check && vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.ts",
    "check": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/migrate.ts",
    "db:init": "npm run db:migrate"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@electric-sql/pglite-socket": "0.0.22",
    "@tanstack/react-query": "^5.107.1",
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.6"
  }
}
